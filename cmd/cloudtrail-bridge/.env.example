# Copy this file to cmd/cloudtrail-bridge/.env and fill in real values, or
# export the same variables directly in your shell -- this file is a
# reference for what the bridge needs, not something the binary itself
# reads automatically (unlike the platform's own docker-compose.yml,
# there is no Compose service loading this).
#
# Scope: this is the CloudTrail bridge's OWN configuration surface,
# deliberately separate from the platform's own root .env
# (.env.example). ADR-0006 frames the bridge as external to the
# platform's two-service Compose deployment; keeping its configuration
# in a separate file, never folded into the platform's .env, preserves
# that same boundary.
#
# See docs/reference-environment.md, "AWS CloudTrail live delivery
# (bridge)" for full setup instructions.

# ---------------------------------------------------------------------
# AWS credentials: DO NOT set here.
# ---------------------------------------------------------------------
# This bridge never reads an AWS access key, secret key, or session
# token from an environment variable of its own -- it calls the AWS
# SDK's standard default credential chain only (config.LoadDefaultConfig)
# and holds nothing else. The approved default operating mode is:
#
#   1. Authenticate once with your own AWS identity, e.g.:
#        aws configure sso
#        aws sso login --profile <your-sso-profile>
#   2. Add a profile to ~/.aws/config that assumes the dedicated
#      cnsdp-cloudtrail-bridge-role (created by
#      scripts/provision-cloudtrail-bridge.ps1), e.g.:
#        [profile cnsdp-cloudtrail-bridge]
#        role_arn = arn:aws:iam::<account-id>:role/cnsdp-cloudtrail-bridge-role
#        source_profile = <your-sso-profile>
#   3. Set AWS_PROFILE=cnsdp-cloudtrail-bridge below (or export it in
#      your shell) before starting the bridge.
#
# The SDK then resolves short-lived, auto-refreshed STS credentials at
# runtime -- no static access key is ever created, stored, or read by
# this program in the default path. A static-key fallback is
# out of scope for this slice (a separately reviewed future change, not
# implemented here).

# The AWS CLI/config profile the bridge should assume credentials from
# (see above). Optional if your shell already has AWS_PROFILE exported,
# or if you are relying on another SDK-recognized ambient credential
# source (e.g. an EC2/ECS instance role) -- never required to be a
# static-key profile.
AWS_PROFILE=cnsdp-cloudtrail-bridge

# Fixed by the approved design (IAM/root CloudTrail events are always
# recorded in us-east-1, ADR-0006) -- do not change.
AWS_REGION=us-east-1

# The bridge's dedicated SQS queue URL (NOT the DLQ). Printed by
# scripts/provision-cloudtrail-bridge.ps1 after a successful run.
SQS_QUEUE_URL=

# The running CNSDP platform's CloudTrail intake endpoint.
CNSDP_ENDPOINT=http://127.0.0.1:8080/v1/cloudtrail-events

# ---------------------------------------------------------------------
# CNSDP_API_TOKEN: DO NOT set a real value in any committed file.
# ---------------------------------------------------------------------
# Same shared bearer token as the platform's own .env API_TOKEN
# (NFR-012) -- obtain it from your existing local CNSDP .env, never
# invent or print a new one here. Export it in your shell before
# starting the bridge instead of writing it into this file, e.g.:
#   $env:CNSDP_API_TOKEN = (Get-Content ..\.env | Select-String '^API_TOKEN=').ToString().Split('=')[1]
CNSDP_API_TOKEN=
