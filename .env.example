# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored -- never commit real values.
#
# Scope: this local .env mechanism is for the single-host Docker Compose
# reference environment ONLY (ARCH-01 §7). It is not the platform's
# future production secrets-supply mechanism, which ARCH-01 §9 leaves
# deliberately deferred.
#
# See docs/reference-environment.md for full setup instructions.

# Bearer token required at every authenticated product-exposed path
# (NFR-012, NFR-013): the intake and alert-retrieval endpoints. Choose a
# long, random value -- this is not a login password, it is compared
# byte-for-byte against every request's Authorization header.
API_TOKEN=

# Password for the "cnsdp" PostgreSQL user. It is embedded directly into
# a postgres:// connection URI (docker-compose.yml), so it must not
# contain characters with special meaning in a URI --
# : / ? # [ ] @ % or whitespace. Stick to letters, digits, and
# - _ . ~ to avoid an invalid connection string.
POSTGRES_PASSWORD=

# Host-side port the application's HTTP endpoint is published on
# (127.0.0.1:${APP_PORT}:8080 in docker-compose.yml). Changes only where
# the container is reachable from the host -- the container's own listen
# address (HTTP_ADDR, default :8080) is unaffected. Override this if
# 8080 is already in use on your machine (e.g. APP_PORT=8081).
APP_PORT=8080
